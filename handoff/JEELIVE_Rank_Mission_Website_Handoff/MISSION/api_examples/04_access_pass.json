{
  "note": "Shape of the pass exchange; token and id masked.",
  "request": {
    "method": "POST",
    "url": "/api/rf/access",
    "body": {
      "access_cookie": "<value of the website's access_token cookie>"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "token": "<43 random characters>",
      "user_id": "<the student's website id>",
      "expires_at": "2026-11-19T10:15:00+00:00"
    }
  },
  "errors": {
    "401": {
      "detail": "Your canonical session needs refreshing."
    },
    "503": {
      "detail": "Could not verify your session. Please retry."
    }
  }
}