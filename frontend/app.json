{
  "expo": {
    "name": "JEELIVE.AI",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/jeelive-icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.jeelivemobile.kt2g15"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/jeelive-adaptive.png",
        "monochromeImage": "./assets/images/jeelive-monochrome.png",
        "backgroundColor": "#08080A"
      },
      "package": "com.emergent.jeelivemobile.kt2g15",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/jeelive-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/jeelive-splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-asset",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": { "manifestQueries": { "package": ["com.whatsapp", "com.whatsapp.w4b"] } }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
